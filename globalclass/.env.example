# Copy to .env and fill in. Never commit the real .env.

# Shared by core-api and streaming-engine (must be identical)
JWT_SECRET=change_me

# LiveKit SFU - https://cloud.livekit.io -> project -> Keys
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<your-api-key>
LIVEKIT_API_SECRET=<your-api-secret>

# First N viewers per lecture get WebRTC, the rest get HLS
WEBRTC_PRIORITY_LIMIT=500
